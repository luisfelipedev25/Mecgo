CREATE DATABASE IF NOT EXISTS mecgo CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci;
USE mecgo;

CREATE TABLE IF NOT EXISTS usuarios (
    id_usuario      INT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
    nome            VARCHAR(100) NOT NULL,
    email           VARCHAR(120) NOT NULL,
    cpf             CHAR(11)     NOT NULL,
    telefone        VARCHAR(11)  NOT NULL,
    senha_hash      VARCHAR(255) NOT NULL,
    tipo            ENUM('cliente','prestador','administrador') NOT NULL DEFAULT 'cliente',
    status          ENUM('ativo','suspenso','bloqueado') NOT NULL DEFAULT 'ativo',
    aceite_lgpd_em  DATETIME NOT NULL,
    criado_em       TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    UNIQUE KEY uq_usuarios_email (email),
    UNIQUE KEY uq_usuarios_cpf (cpf)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

CREATE TABLE IF NOT EXISTS veiculos (
    id_veiculo  INT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
    id_usuario  INT UNSIGNED NOT NULL,
    tipo        ENUM('Carro','Moto') NOT NULL DEFAULT 'Carro',
    placa       VARCHAR(7)   NOT NULL,
    marca       VARCHAR(50)  NOT NULL,
    modelo      VARCHAR(80)  NOT NULL,
    ano         SMALLINT UNSIGNED NOT NULL,
    cor         VARCHAR(30)  NOT NULL,
    criado_em   TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    UNIQUE KEY uq_usuario_placa (id_usuario, placa),
    INDEX idx_usuario (id_usuario),
    CONSTRAINT fk_veiculos_usuario FOREIGN KEY (id_usuario)
        REFERENCES usuarios(id_usuario) ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

CREATE TABLE IF NOT EXISTS atendimentos (
    id_atendimento   INT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
    id_usuario       INT UNSIGNED NOT NULL,
    id_veiculo       INT UNSIGNED NOT NULL,
    id_prestador     INT UNSIGNED NULL,
    categoria_avaria ENUM('Pneu furado','Bateria','Guincho','Pane mecânica') NOT NULL,
    descricao        VARCHAR(500) NULL,
    latitude         DECIMAL(10,7) NOT NULL,
    longitude        DECIMAL(10,7) NOT NULL,
    status           ENUM('Aguardando','Aceito','Em deslocamento','No local',
                          'Em atendimento','Concluído','Cancelado') NOT NULL DEFAULT 'Aguardando',
    valor_total      DECIMAL(10,2) NULL,
    data_hora        TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    INDEX idx_usuario_status (id_usuario, status),
    INDEX idx_status (status),
    CONSTRAINT fk_atend_veiculo FOREIGN KEY (id_veiculo)
        REFERENCES veiculos(id_veiculo)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;
